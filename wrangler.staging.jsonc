{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-rag-preview",
  "main": "staging-worker.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "rag-preview.kegong.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "RAG_API_ORIGIN": "https://rag-api-test.kegong.dev"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "511113",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/v1/chat"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
